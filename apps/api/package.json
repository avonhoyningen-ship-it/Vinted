{
  "name": "@vinted-dashboard/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "test:postgres": "TEST_DB=postgres vitest run",
    "test:pgserver": "TEST_DB=postgres TEST_PG_URL=${TEST_PG_URL:-postgres://supa:supa@127.0.0.1:55433/asktest} vitest run",
    "helper": "tsx src/helper/main.ts",
    "stripe:setup": "tsx --env-file-if-exists=../../.env src/tools/stripeSetup.ts",
    "migrate:cloud": "tsx --env-file-if-exists=../../.env src/tools/migrateToCloud.ts",
    "db:schema": "tsx src/db/printSchema.ts > ../../supabase/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@clerk/backend": "^3.20.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
