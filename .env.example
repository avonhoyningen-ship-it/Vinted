# ---- Sicherheit -------------------------------------------------------------
# 32-Byte-Schlüssel (base64) zum Verschlüsseln der Vinted-Session-Tokens.
# `npm run setup` erzeugt ihn automatisch. NIE ändern, sonst sind gespeicherte
# Sessions nicht mehr lesbar (Accounts müssen dann neu verbunden werden).
ENCRYPTION_KEY=

# Optional: schützt die API mit einem Token (empfohlen auf einem eigenen Server).
# Das Frontend nutzt denselben Wert über NEXT_PUBLIC_API_TOKEN.
API_TOKEN=
NEXT_PUBLIC_API_TOKEN=

# ---- Server -----------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_PATH=./data/vinted.db
STORAGE_DIR=./data/uploads

# ---- KI (Anthropic) ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Vinted -----------------------------------------------------------------
# mock = simulierte Accounts (Entwicklung/Demo), live = echte Vinted-Web-Endpunkte
VINTED_MODE=mock
# Polling-Intervall pro Account (Minuten, min. 5)
POLL_INTERVAL_MINUTES=10
# Standard-Abstand zwischen zwei Veröffentlichungen pro Account (Minuten, min. 5)
PUBLISH_INTERVAL_MINUTES=30
# Mindestabstand zwischen zwei Requests an Vinted pro Account (ms, min. 1000)
VINTED_MIN_REQUEST_GAP_MS=4000
# Nur Mock: zufällige Favoriten/Verkäufe/Nachrichten beim Polling erzeugen
MOCK_RANDOM_EVENTS=false
