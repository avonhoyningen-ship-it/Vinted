# ---- Sicherheit -------------------------------------------------------------
# 32-Byte-Schlüssel (base64) zum Verschlüsseln der Vinted-Session-Tokens.
# `npm run setup` erzeugt ihn automatisch. NIE ändern, sonst sind gespeicherte
# Sessions nicht mehr lesbar (Accounts müssen dann neu verbunden werden).
ENCRYPTION_KEY=

# Passwort für den Login im Dashboard (mind. 4 Zeichen, auf einem Server im Internet mind. 10). `npm run setup` erzeugt eins.
# Leer lassen = kein Login; das Dashboard ist dann NUR auf diesem PC erreichbar (nicht im WLAN).
# Im Server-Betrieb (Docker) Pflicht.
DASHBOARD_PASSWORD=

# Optional: Token für Skripte oder eine spätere Mobile-App (Header "Authorization: Bearer ...").
# Wird nie an den Browser ausgeliefert.
API_TOKEN=

# Nur für den Server-Betrieb: deine (Sub-)Domain, z. B. dashboard.meine-domain.de
DOMAIN=

# ---- Server -----------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Das Dashboard leitet /api intern an die API weiter – normalerweise nichts ändern.
API_INTERNAL_URL=http://127.0.0.1:4000
DATABASE_PATH=./data/vinted.db
STORAGE_DIR=./data/uploads

# ---- KI (Anthropic) ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Vinted -----------------------------------------------------------------
# Polling-Intervall pro Account (Minuten, min. 5)
POLL_INTERVAL_MINUTES=10
# Standard-Abstand zwischen zwei Veröffentlichungen pro Account (Minuten, min. 5)
PUBLISH_INTERVAL_MINUTES=30
# Mindestabstand zwischen zwei Requests an Vinted pro Account (ms, min. 1000)
VINTED_MIN_REQUEST_GAP_MS=4000

# =============================================================================
# CLOUD-VERSION (SaaS) – nur für den Betrieb auf Railway + Vercel.
# Für das lokale Dashboard auf deinem PC bleibt alles unten leer.
# Anleitung Schritt für Schritt: DEPLOY-CLOUD.md
# =============================================================================

# ---- API auf Railway ---------------------------------------------------------
# "cloud" schaltet Nutzerkonten (Clerk), Abo (Stripe), Supabase und den PC-Helfer ein.
APP_MODE=
# Öffentliche Adresse der Web-App (Vercel bzw. deine Domain), z. B. https://app.deine-domain.de
# Wird für Stripe-Rücksprünge und als erlaubte Herkunft (CORS, Clerk) verwendet.
APP_URL=
# Railway setzt PORT selbst. Hinter Railways Proxy:
TRUST_PROXY=

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Das Passwort ist das Datenbank-Passwort aus der Projekt-Erstellung.
DATABASE_URL=
# Supabase → Project Settings → Database → SSL Configuration → "Download certificate".
# Den Inhalt der Datei (-----BEGIN CERTIFICATE----- …) hier einfügen; dann wird die TLS-Verbindung geprüft.
DATABASE_CA_CERT=
# Schema beim Start automatisch anlegen/aktualisieren (Standard: an).
DB_AUTO_MIGRATE=

# Supabase → Project Settings → API: "Project URL" und der "service_role"-Key (geheim, nur auf Railway!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Privater Bucket für die Fotos (wird automatisch angelegt).
SUPABASE_BUCKET=photos

# Clerk → dashboard.clerk.com → deine App → Configure → API keys: "Secret key" (sk_live_… / sk_test_…).
CLERK_SECRET_KEY=
# Optional: "JWT public key" (PEM) – prüft Anmeldungen ohne Netzwerkaufruf zu Clerk.
CLERK_JWT_KEY=

# Stripe → dashboard.stripe.com → Entwickler → API-Schlüssel: "Geheimer Schlüssel" (sk_test_… zum Testen).
STRIPE_SECRET_KEY=
# Werden von `npm run stripe:setup -w apps/api -- --api <Railway-URL>` ausgegeben:
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Zahlungsarten im Checkout. PayPal muss in Stripe unter Einstellungen → Zahlungsmethoden aktiviert sein.
STRIPE_PAYMENT_METHODS=card,paypal

# ---- Web-App auf Vercel ------------------------------------------------------
# Muss "cloud" sein, damit Landingpage, Clerk-Login und Abo-Seite aktiv sind.
NEXT_PUBLIC_APP_MODE=
# Clerk → API keys: "Publishable key" (pk_live_… / pk_test_…). CLERK_SECRET_KEY (oben) braucht Vercel ebenfalls.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Adresse der Railway-API (z. B. https://api.deine-domain.de). Vercel leitet /api dorthin weiter
# (API_INTERNAL_URL oben auf diese Adresse setzen); Foto-Uploads gehen direkt dorthin,
# und die Adresse wird Kunden für den PC-Helfer angezeigt.
NEXT_PUBLIC_DIRECT_API_URL=
# Preis-Anzeige auf der Landingpage (der echte Preis kommt aus Stripe).
NEXT_PUBLIC_PRICE_LABEL=9,99 € / Monat
